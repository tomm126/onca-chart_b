function paletteHtml(sel){
  const safe=sel&&/^#[0-9a-fA-F]{6}$/.test(sel)?sel:PALETTE[0];
  return `<div class="palette-grid">${PALETTE.map(c=>`<div class="pswatch${c===safe?' sel':''}" style="background:${c}" data-c="${c}"></div>`).join('')}</div>
  <div class="hex-row"><input type="color" id="color-picker" value="${safe}"><input type="text" id="color-hex" value="${safe}" maxlength="7" placeholder="#000000"></div>`;
}
function bindPalette(container){
  // 初期値: sel スウォッチ→color-hex→PALETTE[0] の優先順で決定
  const hexInput=container.querySelector('#color-hex');
  const picker=container.querySelector('#color-picker');
  let picked=container.querySelector('.pswatch.sel')?.dataset.c
    ||(hexInput?.value&&/^#[0-9a-fA-F]{6}$/.test(hexInput.value)?hexInput.value:PALETTE[0]);
  // picker と hexInput を初期値に揃える
  if(picker)picker.value=picked;
  if(hexInput)hexInput.value=picked;
  function selectColor(c){
    if(!/^#[0-9a-fA-F]{6}$/.test(c))return;
    picked=c;
    container.querySelectorAll('.pswatch').forEach(s=>s.classList.toggle('sel',s.dataset.c===c));
    if(picker)picker.value=c;
    if(hexInput)hexInput.value=c;
  }
  container.querySelectorAll('.pswatch').forEach(s=>s.addEventListener('click',()=>selectColor(s.dataset.c)));
  picker?.addEventListener('input',()=>selectColor(picker.value));
  hexInput?.addEventListener('input',()=>selectColor(hexInput.value));
  return()=>picked;
}

function projFormHtml(proj){
