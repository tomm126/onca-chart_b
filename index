// dragover: rAFスロットル＋差分チェックでDOM操作を最小化
let _pinDragOverRaf=null,_pinHoveredCell=null;
document.addEventListener('dragover',e=>{
  if(!pinDragData)return;
  e.preventDefault();
  if(_pinDragOverRaf)return;
  _pinDragOverRaf=requestAnimationFrame(()=>{
    _pinDragOverRaf=null;
    const el=document.elementFromPoint(e.clientX,e.clientY);
    const cell=el?.closest('.grid-cell');
    const valid=cell&&cell.dataset.rowId===pinDragData?.rowId&&!cell.classList.contains('nwd-cell');
    const target=valid?cell:null;
    if(target===_pinHoveredCell)return;
    if(_pinHoveredCell){_pinHoveredCell.style.outline='';delete _pinHoveredCell.dataset.pinHover;}
    _pinHoveredCell=target;
    if(target){target.style.outline='2px solid var(--today-line)';target.dataset.pinHover='1';}
  });
});
document.addEventListener('drop',e=>{
  if(!pinDragData)return;
  e.preventDefault();
  if(_pinHoveredCell){_pinHoveredCell.style.outline='';delete _pinHoveredCell.dataset.pinHover;_pinHoveredCell=null;}
  const el=document.elementFromPoint(e.clientX,e.clientY);
  const cell=el?.closest('.grid-cell');
  const toDk=cell?.dataset.dk;
  const d=pinDragData;pinDragData=null;
  if(!cell||cell.dataset.rowId!==d.rowId||cell.classList.contains('nwd-cell')||toDk===d.fromDk)return;
  saveHistory();
  const fromPins=state.pins[d.rowId]?.[d.fromDk];if(!fromPins)return;
  const pinObj=fromPins.find(p=>p.id===d.pinId);if(!pinObj)return;
  state.pins[d.rowId][d.fromDk]=fromPins.filter(p=>p.id!==d.pinId);
  if(!state.pins[d.rowId][d.fromDk].length)delete state.pins[d.rowId][d.fromDk];
  if(!state.pins[d.rowId][toDk])state.pins[d.rowId][toDk]=[];
  state.pins[d.rowId][toDk].push(pinObj);
  render();
});

let pinResize={on:false,pinId:null,rowId:null,startDk:null,startX:0,origSpan:1};
document.addEventListener('mousemove',e=>{
  if(!pinResize.on)return;
  const newSpan=Math.max(1,pinResize.origSpan+Math.round((e.clientX-pinResize.startX)/26));
  const pin=state.pins[pinResize.rowId]?.[pinResize.startDk]?.find(p=>p.id===pinResize.pinId);
  if(pin&&pin.span!==newSpan){pin.span=newSpan;renderPinsOnly();}
});
document.addEventListener('mouseup',()=>{if(pinResize.on){saveHistory();pinResize.on=false;}});

// ── ARCHIVE BAR DRAG ──
let arcDrag={on:false,startX:0,startDk:''};
const arcBar=document.getElementById('archive-bar');
arcBar.addEventListener('mousedown',e=>{
  e.preventDefault();e.stopPropagation();
  const days=getDays();
  const si=days.findIndex(d=>dk(d)===state.view.archiveBefore);
  const startBarLeft=si>=0?(si+1)*26-0.5:90*26-0.5;
  arcDrag={on:true,startX:e.clientX,startDk:state.view.archiveBefore,startIdx:si>=0?si:90,startBarLeft};
  arcBar.classList.add('dragging');
});
arcBar.addEventListener('touchstart',e=>{
  e.preventDefault();e.stopPropagation();
  const touch=e.touches[0];
  const days=getDays();
  const si=days.findIndex(d=>dk(d)===state.view.archiveBefore);
  const startBarLeft=si>=0?(si+1)*26-0.5:90*26-0.5;
  arcDrag={on:true,startX:touch.clientX,startDk:state.view.archiveBefore,startIdx:si>=0?si:90,startBarLeft};
  arcBar.classList.add('dragging');
},{passive:false});
document.addEventListener('touchmove',e=>{
  if(!arcDrag.on||!e.touches[0])return;
  e.preventDefault();
  const dx=e.touches[0].clientX-arcDrag.startX;
  const deltaDays=Math.round(dx/26);
  arcBar.style.left=(arcDrag.startBarLeft+deltaDays*26)+'px';
  const newDk=dk(addD(new Date(arcDrag.startDk),deltaDays));
  if(newDk===state.view.archiveBefore)return;
  state.view.archiveBefore=newDk;
  const days=getDays();
  document.querySelectorAll('.day-cell').forEach((el,i)=>{
    if(i>=days.length)return;
    const dstr=dk(days[i]);
    if(isNWD(dstr,days[i]))return;
    const arc=isArchived(dstr),dobj=days[i],dw=dobj.getDay();
    el.classList.toggle('arc-hdr',arc);
    el.classList.toggle('sat',!arc&&dw===6);
    el.classList.toggle('sun',!arc&&dw===0);
    el.classList.toggle('hol',!arc&&isHol(dobj)&&dw!==0&&dw!==6);
    el.classList.toggle('today-hdr',!arc&&dstr===todayStr());
  });
  document.querySelectorAll('.grid-cell').forEach(cell=>{
    const dstr=cell.dataset.dk;if(!dstr||isNWD(dstr,new Date(dstr.replace(/-/g,'/'))))return;
    cell.classList.toggle('arc-cell',isArchived(dstr));
  });
},{passive:false});
document.addEventListener('touchend',()=>{
  if(arcDrag.on){arcDrag.on=false;arcBar.classList.remove('dragging');}
});
let rafArc=false;
document.addEventListener('mousemove',e=>{
  if(!arcDrag.on)return;
  if(rafArc)return;rafArc=true;requestAnimationFrame(()=>{rafArc=false;});
  const dx=e.clientX-arcDrag.startX;
  const deltaDays=Math.round(dx/26);
  // Move bar visually using stored startBarLeft
  arcBar.style.left=(arcDrag.startBarLeft+deltaDays*26-0.5)+'px';
  const newDk=dk(addD(new Date(arcDrag.startDk),deltaDays));
  if(newDk===state.view.archiveBefore)return;
  state.view.archiveBefore=newDk;
  const days=getDays();
  document.querySelectorAll('.day-cell').forEach((el,i)=>{
    if(i>=days.length)return;
    const dstr=dk(days[i]);
    if(isNWD(dstr))return;
    const arc=isArchived(dstr),dobj=new Date(dstr.replace(/-/g,'/')),dw=dobj.getDay();
    el.classList.toggle('arc-hdr',arc);
    el.classList.toggle('sat',!arc&&dw===6);
    el.classList.toggle('sun',!arc&&dw===0);
    el.classList.toggle('hol',!arc&&isHol(dobj)&&dw!==0&&dw!==6);
    el.classList.toggle('today-hdr',!arc&&dstr===todayStr());
  });
  document.querySelectorAll('.grid-cell').forEach(cell=>{
    const dstr=cell.dataset.dk;if(!dstr||isNWD(dstr))return;
    cell.classList.toggle('arc-cell',isArchived(dstr));
  });});
document.addEventListener('mouseup',()=>{
  if(arcDrag.on){arcDrag.on=false;arcBar.classList.remove('dragging');}
});

// ── RENDER ──
function render(){renderLegend();renderFilter();renderHeader();renderRows();updateArchiveBar();}

function renderLegend(){
  const el=document.getElementById('legend');
  el.innerHTML=state.members.map(m=>`<div class="leg-wrap" data-mid="${m.id}"><div class="leg-dot" style="background:${m.color}"></div><div class="leg-tip">${m.name}</div></div>`).join('');
  el.querySelectorAll('.leg-wrap').forEach(w=>w.addEventListener('click',()=>openMemberPanel(w.dataset.mid)));
}

function renderFilter(){
  const dd=document.getElementById('filter-dropdown');
  dd.innerHTML=`<div class="filter-item" id="filter-clear"><span style="font-size:10px;color:var(--text3)">すべて表示</span></div>`+
    state.members.map(m=>`<div class="filter-item"><input type="checkbox" id="fc-${m.id}" ${filterMembers.has(m.id)?'checked':''}><div class="filter-dot" style="background:${m.color}"></div><span>${m.name}</span></div>`).join('');
  dd.querySelector('#filter-clear').addEventListener('click',()=>{filterMembers.clear();renderFilter();render();updateFilterBtn();});
  state.members.forEach(m=>{
    dd.querySelector(`#fc-${m.id}`)?.addEventListener('change',e=>{
      if(e.target.checked)filterMembers.add(m.id);else filterMembers.delete(m.id);
      render();updateFilterBtn();
    });
  });
}

function updateFilterBtn(){
  document.getElementById('btn-filter').classList.toggle('filter-active',filterMembers.size>0);
}

function renderHeader(){
  const days=getDays();
  const mr=document.getElementById('month-row'),dr=document.getElementById('day-row');
  mr.innerHTML='';dr.innerHTML='';
  const months=[];
  days.forEach(d=>{
    const key=`${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,'0')}`;
    if(!months.length||months[months.length-1].key!==key)months.push({key,label:key,w:26});
    else months[months.length-1].w+=26;
  });
  months.forEach(m=>{const el=document.createElement('div');el.className='month-cell';el.style.width=m.w+'px';el.textContent=m.label;mr.appendChild(el);});
  days.forEach(d=>{
    const dstr=dk(d),dw=d.getDay(),arc=isArchived(dstr),nwd=isNWD(dstr,d);
    const el=document.createElement('div');el.className='day-cell';
    if(nwd)el.classList.add('nwd');
    else if(arc)el.classList.add('arc-hdr');
    // ②土日・祝日の文字色は非稼働日・アーカイブに関わらず常に付与
    if(!arc){
      if(dw===6)el.classList.add('sat');
      else if(dw===0)el.classList.add('sun');
      else if(isHol(d))el.classList.add('hol');
    }
    if(!nwd&&!arc&&dstr===todayStr())el.classList.add('today-hdr');
    el.innerHTML=`<span>${d.getDate()}</span>`;
    el.addEventListener('contextmenu',e=>{
      e.preventDefault();
      const isCustomNWD=state.customNonWorkingDays.includes(dstr);
      const isRemovedHol=state.removedHolidays.includes(dstr);
      const isDefaultNWD=(isWknd(d)||isHol(d))&&!isRemovedHol;
      showCtx(e,`
        <div class="ctx-item" data-action="arc-to">🗂 ここまでをアーカイブ</div>
        <div class="ctx-item" data-action="arc-week">🗂 この週までをアーカイブ</div>
        <div class="ctx-sep"></div>
        ${nwd
          ?`<div class="ctx-item" data-action="rm-nwd">✓ 非稼働日を解除</div>`
          :`<div class="ctx-item" data-action="add-nwd">🚫 非稼働日に設定</div>`
        }
      `,{
        'arc-to':()=>{state.view.archiveBefore=dstr;updateArchiveBar();render();},
        'arc-week':()=>{
          const dobj=new Date(dstr),dw2=dobj.getDay();
          state.view.archiveBefore=dk(addD(dobj,dw2===0?0:7-dw2));
          updateArchiveBar();render();
        },
        'add-nwd':()=>{
          saveHistory();
          if(!state.customNonWorkingDays.includes(dstr))state.customNonWorkingDays.push(dstr);
          // 土日・祝日をremovedHolidaysから除去して非稼働日に戻す
          state.removedHolidays=state.removedHolidays.filter(x=>x!==dstr);
          render();
        },
        'rm-nwd':()=>{
          saveHistory();
          state.customNonWorkingDays=state.customNonWorkingDays.filter(x=>x!==dstr);
          if(isDefaultNWD&&!state.removedHolidays.includes(dstr))state.removedHolidays.push(dstr);
          render();
        },
      });
    });
    dr.appendChild(el);
  });
}

function renderRows(){
  const days=getDays();
  const ra=document.getElementById('rows-area'),lr=document.getElementById('left-rows');
  ra.innerHTML='';lr.innerHTML='';
  const{norm,pin}=visProjects();

  function renderGroup(proj,isPinned){
    const lg=document.createElement('div');
    lg.className='lp-group'+(isPinned?' pinned-group':'');lg.dataset.projId=proj.id;
    if(proj.status!=='active')lg.classList.add('status-'+proj.status);

    // Spanning handle wrapper
    const lgInner=document.createElement('div');lgInner.className='lp-group-inner';
    const lgHandle=document.createElement('div');lgHandle.className='lp-group-handle';lgHandle.textContent='⠿';
    lgHandle.setAttribute('draggable','true');
    const lgRows=document.createElement('div');lgRows.className='lp-group-rows';
    lgInner.appendChild(lgHandle);lgInner.appendChild(lgRows);
    lg.appendChild(lgInner);

    // 列ベース構造: 左側（info列）+ 右側（member列）
    const rowCount=proj.rows.length;
    const sLabel={submitted:'coding',testup:'test up'}[proj.status]||'';
    const groupH=rowCount*parseInt(getComputedStyle(document.documentElement).getPropertyValue('--row-h')||'24');

    // 左側情報列（name/pages/start/dead）- 結合セル
    const lrInfo=document.createElement('div');lrInfo.className='lp-row-info';
    const startOverdue=proj.start&&isStartOverdue(proj.start);
    lrInfo.innerHTML=`
      <div class="lp-cell lp-name"><div class="lp-name-wrap"><span class="lp-name-text" title="${proj.name}">${proj.name}</span>${sLabel?`<span class="status-label">${sLabel}</span>`:''}</div></div>
      <div class="lp-cell lp-pages">${proj.pages||''}</div>
      <div class="lp-cell lp-start${startOverdue?' overdue':''}">${formatStartCell(proj.start||'')}</div>
      <div class="lp-cell lp-dead">${proj.deadline||''}</div>
    `;
    // イベント設定
    const nameEl=lrInfo.querySelector('.lp-name');
    nameEl.addEventListener('click',e=>{e.stopPropagation();showProjCtx(e,proj);});
    nameEl.addEventListener('dblclick',e=>{e.stopPropagation();openInlineCellEdit(nameEl,()=>proj.name,v=>{if(v)proj.name=v;});});
    lrInfo.querySelector('.lp-pages')?.addEventListener('dblclick',e=>{e.stopPropagation();const el=lrInfo.querySelector('.lp-pages');openInlineCellEdit(el,()=>proj.pages||'',v=>{proj.pages=v;});});
    lrInfo.querySelector('.lp-start')?.addEventListener('dblclick',e=>{e.stopPropagation();const el=lrInfo.querySelector('.lp-start');openInlineCellEdit(el,()=>proj.start||'',v=>{proj.start=v;});});
    lrInfo.querySelector('.lp-dead')?.addEventListener('dblclick',e=>{e.stopPropagation();const el=lrInfo.querySelector('.lp-dead');openInlineCellEdit(el,()=>proj.deadline||'',v=>{proj.deadline=v;});});
    lgHandle.addEventListener('dragstart',e=>{dragProj={on:true,projId:proj.id,pinned:isPinned};e.dataTransfer.effectAllowed='move';lg.style.opacity='.4';});
    lgHandle.addEventListener('dragend',()=>{lg.style.opacity='';dragProj.on=false;render();});

    // 右側担当者列（member列のみ複数行）
    const lrMembers=document.createElement('div');lrMembers.className='lp-member-rows';
    proj.rows.sort((a,b)=>a.order-b.order).forEach((row,ri)=>{
      const mem=getMem(row.memberId);
      const lr2=document.createElement('div');lr2.className='lp-row';lr2.dataset.rowId=row.id;
      lr2.innerHTML=`<div class="lp-cell lp-member-cell"><span class="member-tag" draggable="true" style="background:${mem.color};color:#ffffff;cursor:grab">${mem.name}</span></div>`;
      const tag=lr2.querySelector('.member-tag');
      // prevent click from firing after a drag operation
      let tagDragged=false;
      tag.addEventListener('dragstart',e=>{
        tagDragged=false; // reset, will be set true on move
        e.stopPropagation();
        e.dataTransfer.effectAllowed='move';
        rowDragData={rowId:row.id,projId:proj.id};
        e.dataTransfer.setData('text/plain','row');
        setTimeout(()=>{tagDragged=true;lr2.classList.add('row-dragging');},0);
      });
      tag.addEventListener('click',e=>{if(tagDragged){tagDragged=false;return;}
        e.stopPropagation();
        showCtx(e,`
          <div class="ctx-item" data-action="chg">✏️ 担当者を変更</div>
          <div class="ctx-item" data-action="shift">&#8596; スケジュールをずらす</div>
          <div class="ctx-sep"></div>
          <div class="ctx-item" data-action="clr">🧹 スケジュールをクリア</div>
          <div class="ctx-item danger" data-action="del">🗑 この行を削除</div>
        `,{
          chg:()=>openRowPanel(proj,row),
          shift:()=>openShiftPanel(proj,row),
          clr:()=>{saveHistory();row.cells={};render();},
          del:()=>{if(proj.rows.length>1){saveHistory();proj.rows=proj.rows.filter(r=>r.id!==row.id);render();}else{alert('最後の担当者行は削除できません。');}}
        });
      });
      // D&D row reorder — drag from name tag (#88)
      tag.addEventListener('dragend',()=>{
        rowDragData=null;
        lr2.classList.remove('row-dragging');
        document.querySelectorAll('.lp-row').forEach(r=>r.classList.remove('row-drag-over-top','row-drag-over-bottom'));
      });
      lr2.addEventListener('dragover',e=>{
        if(!rowDragData||rowDragData.projId!==proj.id)return;
        e.preventDefault();e.stopPropagation();
        document.querySelectorAll('.lp-row').forEach(r=>r.classList.remove('row-drag-over-top','row-drag-over-bottom'));
        const rect=lr2.getBoundingClientRect();
        lr2.classList.add(e.clientY<rect.top+rect.height/2?'row-drag-over-top':'row-drag-over-bottom');
      });
      lr2.addEventListener('dragleave',()=>{lr2.classList.remove('row-drag-over-top','row-drag-over-bottom');});
      lr2.addEventListener('drop',e=>{
        e.preventDefault();e.stopPropagation();
        lr2.classList.remove('row-drag-over-top','row-drag-over-bottom');
        const d=rowDragData;
        if(!d||d.projId!==proj.id||d.rowId===row.id)return;
        const rect=lr2.getBoundingClientRect();
        const before=e.clientY<rect.top+rect.height/2;
        saveHistory();
        const rows=proj.rows.sort((a,b)=>a.order-b.order);
        const fi=rows.findIndex(r=>r.id===d.rowId),ti=rows.findIndex(r=>r.id===row.id);
        if(fi<0||ti<0)return;
        const moved=rows.splice(fi,1)[0];
        rows.splice(before?(ti-(fi<ti?1:0)):(ti+(fi>ti?1:0)),0,moved);
        rows.forEach((r,i)=>r.order=i);
        proj.rows=[...rows];
        render();
      });
      lrMembers.appendChild(lr2);
    });

    // lrInfoとlrMembersをlp-group-rowに組み合わせる
    const lrGroup=document.createElement('div');lrGroup.className='lp-row-group';
    lrGroup.appendChild(lrInfo);
    lrGroup.appendChild(lrMembers);
    lgRows.appendChild(lrGroup);

    const addHint=document.createElement('div');addHint.className='lp-add-row';addHint.textContent='＋ 担当追加';
    addHint.addEventListener('click',()=>openAddRowPanel(proj));lgRows.appendChild(addHint);

    lg.addEventListener('dragover',e=>{
      if(!dragProj.on||dragProj.projId===proj.id||dragProj.pinned!==isPinned)return;
      e.preventDefault();
      document.querySelectorAll('.lp-group').forEach(g=>g.classList.remove('drag-over-top','drag-over-bottom'));
      const r=lg.getBoundingClientRect();lg.classList.add(e.clientY<r.top+r.height/2?'drag-over-top':'drag-over-bottom');
    });
    lg.addEventListener('drop',e=>{
      if(!dragProj.on||dragProj.projId===proj.id||dragProj.pinned!==isPinned)return;
      e.preventDefault();
      const r=lg.getBoundingClientRect(),before=e.clientY<r.top+r.height/2;
      const arr=isPinned?visProjects().pin:visProjects().norm;
      const fi=arr.findIndex(p=>p.id===dragProj.projId),ti=arr.findIndex(p=>p.id===proj.id);
      if(fi<0||ti<0)return;
      const moved=arr.splice(fi,1)[0];
      arr.splice(before?(ti-(fi<ti?1:0)):(ti+(fi>ti?1:0)),0,moved);
      saveHistory();
      arr.forEach((p,i)=>p.order=i);
      document.querySelectorAll('.lp-group').forEach(g=>g.classList.remove('drag-over-top','drag-over-bottom'));
      render();
    });

    const gg=document.createElement('div');gg.className='grid-group'+(isPinned?' pinned-grid':'');
    // グリッド側: 日付ごとに1列を生成し、その中に担当者数分のセルを縦に積む
    days.forEach((d,di)=>{
      const dstr=dk(d),nwd=isNWD(dstr,d),arc=isArchived(dstr);
      const col=document.createElement('div');col.className='grid-col';
      proj.rows.sort((a,b)=>a.order-b.order).forEach((row,gri)=>{
        const mem=getMem(row.memberId);
        const rgb=hexToRgb(mem.color);
        const cell=document.createElement('div');cell.className='grid-cell';
        cell.dataset.dk=dstr;cell.dataset.rowId=row.id;cell.dataset.di=di;
        if(nwd){cell.classList.add('nwd-cell');}
        else{
          if(isWknd(d))cell.classList.add('wknd');
          if(dstr===todayStr())cell.classList.add('td');
          if(arc)cell.classList.add('arc-cell');
          if(row.cells[dstr])cell.style.background=mem.color+'aa';
          cell.addEventListener('mouseenter',()=>{
            if(hoveredDk!==dstr||hoveredRowId!==row.id){
              clearCrossHighlight();
              hoveredDk=dstr;hoveredRowId=row.id;
              applyColHighlight(dstr,true);
              applyRowHighlight(row.id,true);
            }
            if(!drag.on&&!row.cells[dstr])cell.style.background=`rgba(${rgb},.13)`;
          });
          cell.addEventListener('mouseleave',()=>{
            if(!row.cells[dstr])cell.style.background='';
          });
          cell.addEventListener('mousedown',e=>{
            if(e.button!==0)return;e.preventDefault();
            drag={on:true,rowId:row.id,painting:!row.cells[dstr],lastIdx:parseInt(cell.dataset.di)};
            applyCell(proj,row,dstr,drag.painting,true);
          });
          cell.addEventListener('touchstart',e=>{
            e.preventDefault();
            drag={on:true,rowId:row.id,painting:!row.cells[dstr],lastIdx:parseInt(cell.dataset.di)};
            applyCell(proj,row,dstr,drag.painting,true);
          },{passive:false});
          cell.addEventListener('contextmenu',e=>{
            e.preventDefault();e.stopPropagation();
            const _hasPins=state.pins[row.id]?.[dstr]?.length>0;
            const _nwd=isNWD(dstr,d)||isArchived(dstr);
            showCtx(e,`
              ${(!_hasPins&&!_nwd)?'<div class="ctx-item" data-action="pin">📌 ピンを追加</div><div class="ctx-sep"></div>':''}
              <div class="ctx-item" data-action="bulk">📅 日数を指定して追加</div>
            `,{
              pin:()=>openInlinePin(cell,row,dstr),
              bulk:()=>openBulkAddModal(proj,row,dstr)
            });
          });
        }
        col.appendChild(cell);
      });
      // ピンは最初の行(row[0])に紐付け
      gg.appendChild(col);
    });
    // ピンを別途描画
    proj.rows.sort((a,b)=>a.order-b.order).forEach((row,gri)=>{
      renderRowPinsCol(gg,row,days,gri);
    });
    const ggWrap=document.createElement('div');ggWrap.className='grid-group-wrap';ggWrap.dataset.projId=proj.id;
    const spacer=document.createElement('div');spacer.className='grid-spacer';
    ggWrap.appendChild(gg);ggWrap.appendChild(spacer);
    lr.appendChild(lg);ra.appendChild(ggWrap);
  }

  norm.forEach(p=>renderGroup(p,false));
  if(pin.length){
    const ls=document.createElement('div');ls.id='pinned-sep';ls.textContent='固定案件';lr.appendChild(ls);
    const gs=document.createElement('div');gs.className='grid-sep';gs.style.width=(getDays().length*26)+'px';ra.appendChild(gs);
    pin.forEach(p=>renderGroup(p,true));
  }
  // #68: add spacer to left-rows AND rows-area so scroll bottoms match
  const lrSpacer=document.createElement('div');
  lrSpacer.style.cssText='height:36px;flex-shrink:0;';
  lr.appendChild(lrSpacer);
  const raSpacer=document.createElement('div');
  raSpacer.style.cssText='height:36px;';
  ra.appendChild(raSpacer);
  buildCellMap();
  // 左ペインとグリッドの高さを同期
  setTimeout(()=>{
    document.querySelectorAll('.lp-group').forEach(lg=>{
      const projId=lg.dataset.projId;
      if(!projId)return;
      const ggWrap=document.querySelector('.grid-group-wrap[data-proj-id="'+projId+'"]');
      if(!ggWrap)return;
      const lpH=lg.offsetHeight;
      const gg=ggWrap.querySelector('.grid-group');
      const sp=ggWrap.querySelector('.grid-spacer');
      if(!gg||!sp)return;
      // グリッドのgroupとspacerの現在の合計高さ
      const ggH=lg.querySelector('.lp-group-rows')?.offsetHeight||lpH;
      const rowsH=ggH - (lg.querySelector('.lp-add-row')?.offsetHeight||18);
      // grid-groupを担当者行分の高さに設定
      gg.style.height=rowsH+'px';
      gg.style.width=(getDays().length*26)+'px';
      gg.querySelectorAll('.grid-col').forEach(col=>{
        col.style.height=rowsH+'px';
      });
      // grid-spacerを左右の高さが一致するよう調整
      const currentTotal=gg.offsetHeight+sp.offsetHeight;
      const diff=lpH-currentTotal;
      sp.style.height=(sp.offsetHeight+diff)+'px';
    });
  },0);
}

function renderRowPinsCol(gg,row,days,rowIdx){
  const cols=gg.querySelectorAll('.grid-col');
  // ── ピン描画 ──
  const rp=state.pins[row.id];if(!rp)return;
  Object.entries(rp).forEach(([dstr,pins])=>{
    if(!pins||!pins.length)return;
    const idx=days.findIndex(d=>dk(d)===dstr);if(idx<0)return;
    const col=cols[idx];if(!col)return;
    const cells=col.querySelectorAll('.grid-cell');
    const cell=cells[rowIdx];if(!cell||cell.classList.contains('nwd-cell'))return;
    pins.forEach(pin=>{
      const wrap=document.createElement('div');wrap.className='pin-wrap';wrap.style.width=((pin.span||1)*26)+'px';
      wrap.setAttribute('draggable','true');
      wrap.innerHTML=`<div class="pin-label-inner" style="cursor:grab">${pin.label}</div><div class="pin-resize"></div>`;
      wrap.addEventListener('mousedown',e=>{e.stopPropagation();});
      wrap.addEventListener('click',e=>{e.stopPropagation();});
      // pin D&D: drag from wrap (#89)
      wrap.addEventListener('dragstart',e=>{
        e.stopPropagation();
        e.dataTransfer.effectAllowed='move';
        pinDragData={pinId:pin.id,rowId:row.id,fromDk:dstr};
        e.dataTransfer.setData('text/plain','pin');
        // dragstart時に全pin-wrapのpointer-eventsを無効化→dragover中のelementFromPointが軽量になる
        setTimeout(()=>{
          wrap.style.opacity='.35';
          document.querySelectorAll('.pin-wrap').forEach(w=>w.style.pointerEvents='none');
        },0);
      });
      wrap.addEventListener('dragend',()=>{
        wrap.style.opacity='';
        document.querySelectorAll('.pin-wrap').forEach(w=>w.style.pointerEvents='');
        if(_pinHoveredCell){_pinHoveredCell.style.outline='';delete _pinHoveredCell.dataset.pinHover;_pinHoveredCell=null;}
        pinDragData=null;
      });
      wrap.querySelector('.pin-resize').addEventListener('mousedown',e=>{
        e.preventDefault();e.stopPropagation();
        pinResize={on:true,pinId:pin.id,rowId:row.id,startDk:dstr,startX:e.clientX,origSpan:pin.span||1};
      });
      wrap.querySelector('.pin-label-inner').addEventListener('dblclick',e=>{
        e.stopPropagation();e.preventDefault();
        const origLabel=pin.label;
        const inp=document.createElement('input');
        inp.type='text';inp.value='';
        inp.style.cssText='position:absolute;inset:0;width:100%;border:none;background:var(--pin-color,#888);font-size:9px;padding:0 5px;outline:none;z-index:10;color:#fff;border-radius:3px;';
        wrap.appendChild(inp);inp.focus();
        let committed=false;
        function commitEdit(){
          if(committed)return;committed=true;
          const val=inp.value.trim();inp.remove();
          const newLabel=val||origLabel;
          if(newLabel!==origLabel){saveHistory();pin.label=newLabel;render();}
        }
        function cancelEdit(){if(committed)return;committed=true;inp.remove();}
        inp.addEventListener('keydown',ev=>{
          if(ev.key==='Enter'&&!ev.isComposing)commitEdit();
          if(ev.key==='Escape')cancelEdit();
        });
        inp.addEventListener('blur',commitEdit);
      });
      wrap.addEventListener('contextmenu',e=>{
        e.preventDefault();e.stopPropagation();
        showCtx(e,`<div class="ctx-item danger" data-action="del">✕ ピンを削除</div>`,{
          del:()=>{saveHistory();state.pins[row.id][dstr]=state.pins[row.id][dstr].filter(p=>p.id!==pin.id);if(!state.pins[row.id][dstr].length)delete state.pins[row.id][dstr];render();}
        });
      });
      cell.appendChild(wrap);
    });
  });
}

function renderPinsOnly(){
  document.querySelectorAll('.pin-wrap').forEach(el=>el.remove());
  const days=getDays();
  // v18列ベース構造: grid-group-wrap → grid-group → grid-col → grid-cell
  document.querySelectorAll('.grid-group-wrap').forEach(ggWrap=>{
    const gg=ggWrap.querySelector('.grid-group');if(!gg)return;
    const projId=ggWrap.dataset.projId;
    const proj=state.projects.find(p=>p.id===projId);if(!proj)return;
    const visRows=proj.rows.slice().sort((a,b)=>a.order-b.order);
    visRows.forEach((row,rowIdx)=>{
      renderRowPinsCol(gg,row,days,rowIdx);
    });
  });
}

