  // defaults: 担当1=ディレクター(m13), 担当2=デザイナー(m14), 担当3=エンジニア(m15)
  const defM1=state.members.find(m=>m.id==='m13')?.id||state.members[0]?.id||'';
  const defM2=state.members.find(m=>m.id==='m14')?.id||state.members[1]?.id||'';
  const defM3=state.members.find(m=>m.id==='m15')?.id||'';
  const memOptsM1=state.members.map(m=>`<option value="${m.id}"${m.id===defM1?' selected':''}>${m.name}</option>`).join('');
  const memOptsM2=state.members.map(m=>`<option value="${m.id}"${m.id===defM2?' selected':''}>${m.name}</option>`).join('');
  const memOptsM3=state.members.map(m=>`<option value="${m.id}"${m.id===defM3?' selected':''}>${m.name}</option>`).join('');
  return`
    <div class="fg"><label>案件名</label><input type="text" id="pname" value="${proj?.name||''}"></div>
    <div class="fg"><label>ページ数</label><input type="text" id="ppages" value="${proj?.pages||''}" placeholder="例：18P"></div>
    <div class="fg"><label>制作開始</label><input type="text" id="pstart" value="${proj?.start||''}" placeholder="例：2025/6"></div>
