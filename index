let rafDrag=false;
document.addEventListener('mousemove',e=>{
  if(!drag.on)return;
  const el=document.elementFromPoint(e.clientX,e.clientY);if(!el)return;
  const cell=el.closest('.grid-cell');if(!cell||cell.classList.contains('nwd-cell'))return;
  const dstr=cell.dataset.dk,rowId=cell.dataset.rowId;
  if(!dstr||rowId!==drag.rowId)return;
  const curIdx=parseInt(cell.dataset.di);
  if(rafDrag)return;
  rafDrag=true;
  requestAnimationFrame(()=>{
    rafDrag=false;
    const days=getDays();
    const from=drag.lastIdx>=0?drag.lastIdx:curIdx,to=curIdx,step=from<=to?1:-1;
    for(let i=from;i!==to+step;i+=step){
      if(i<0||i>=days.length)continue;
      const d2=dk(days[i]);
      if(isNWD(d2))continue;
      const tc=cellMap.get(rowId+'__'+d2);
      if(!tc||tc.classList.contains('nwd-cell')||tc.classList.contains('arc-cell'))continue;
      for(const proj of state.projects){
        const row=proj.rows.find(r=>r.id===rowId);
        if(row){applyCell(proj,row,d2,drag.painting,true);break;}
      }
    }
    drag.lastIdx=curIdx;
  });
});;

