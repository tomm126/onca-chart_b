// ── UNDO / REDO ──
const MAX_HISTORY=50;
let undoStack=[];  // snapshots BEFORE each operation
let redoStack=[];  // snapshots that were undone
let skipHistory=false;

function takeSnapshot(){
  return JSON.stringify({
    projects:state.projects.map(p=>({...p,rows:p.rows.map(r=>({...r,cells:{...r.cells}}))})),
    pins:JSON.parse(JSON.stringify(state.pins)),
    customNonWorkingDays:[...state.customNonWorkingDays],
    removedHolidays:[...state.removedHolidays],
  });
}

function saveHistory(){
  if(skipHistory)return;
  undoStack.push(takeSnapshot());
  redoStack=[];  // new operation clears redo
  if(undoStack.length>MAX_HISTORY)undoStack.shift();
}

function restoreSnap(snap){
  const d=JSON.parse(snap);
  skipHistory=true;
  state.projects=d.projects;
  state.pins=d.pins;
  state.customNonWorkingDays=d.customNonWorkingDays;
  state.removedHolidays=d.removedHolidays;
  render();
  skipHistory=false;
}

function undo(){
  if(undoStack.length===0){showToast('これ以上取り消せません');return;}
  redoStack.push(takeSnapshot());  // save current for redo
  restoreSnap(undoStack.pop());
  showToast('取り消し');
}
function redo(){
  if(redoStack.length===0){showToast('これ以上やり直せません');return;}
  undoStack.push(takeSnapshot());  // save current for undo
  restoreSnap(redoStack.pop());
  showToast('やり直し');
}

