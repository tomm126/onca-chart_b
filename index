// ── NON-WORKING DAYS ──
function parseStartDate(startStr){
  if(!startStr)return null;
  const m=startStr.match(/^(\d{4})[\/\-](\d{1,2})(?:[\/\-](\d{1,2}))?/);
  if(m)return new Date(parseInt(m[1]),parseInt(m[2])-1,m[3]?parseInt(m[3]):1);
  const d=new Date(startStr);return isNaN(d.getTime())?null:d;
}
function getElapsedDays(startStr){
  const d=parseStartDate(startStr);if(!d)return null;
  return Math.floor((Date.now()-d.getTime())/(1000*60*60*24));
}
function formatStartCell(startStr){
  if(!startStr)return '';
  const days=getElapsedDays(startStr);
  if(days===null||days<0)return startStr;
  const months=Math.floor(days/30);
  const remDays=days%30;
  const elapsed=months>0?(months+'m '+remDays+'d'):(days+'d');
  return startStr+'\n('+elapsed+')';
}
function isStartOverdue(startStr){
  if(!startStr)return false;
  let d;
  const m=startStr.match(/^(\d{4})[\/\-](\d{1,2})(?:[\/\-](\d{1,2}))?/);
  if(m){d=new Date(parseInt(m[1]),parseInt(m[2])-1,m[3]?parseInt(m[3]):1);}
  else{d=new Date(startStr);}
  if(isNaN(d.getTime()))return false;
  const ago=new Date();ago.setMonth(ago.getMonth()-6);
  return d<=ago;
}
function isNWD(dstr,d){
  if(state.removedHolidays.includes(dstr)) return false;
  // Use passed Date object if available, otherwise parse string with slash (local time)
  const dateObj = d || new Date(dstr.replace(/-/g,'/'));
  if(isWknd(dateObj)||isHol(dateObj)) return true;
  return state.customNonWorkingDays.includes(dstr);
}


